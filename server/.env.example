NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nivaran
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./private-uploads

# Optional SMTP settings for invitation and password-reset email delivery
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nivaran <no-reply@example.com>

# Google Identity Services Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
